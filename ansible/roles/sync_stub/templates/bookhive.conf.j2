
server {
    listen {{ puerto_app }};
    server_name _;

    location /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"bookhive-sync"}';
    }

    location / {
        default_type application/json;
        return 200 '{"service":"bookhive-sync","status":"running"}';
    }
}
